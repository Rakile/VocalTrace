# =============================================================================
# VocalTrace — environment / API keys
# =============================================================================
# Installer copies this to ".env" if missing. launch.py loads .env on startup.
# Edit .env, save, restart the app (run.bat).
# =============================================================================

# --- Hugging Face token (needed for Pyannote diarization) --------------------
#
# Most pyannote/* models are GATED. You need BOTH:
#
#   A) A personal access token
#        https://huggingface.co/settings/tokens
#        (classic "read" token is enough)
#
#   B) Accept the model terms while logged into the same account
#        Open each model page and click through the license / access form, e.g.:
#          https://huggingface.co/pyannote/speaker-diarization-3.1
#          https://huggingface.co/pyannote/speaker-diarization-community-1
#        If download fails, also accept linked models mentioned in the error
#        (often segmentation / embedding checkpoints under pyannote/*).
#
# Then set:
HF_TOKEN_TRANSCRIBE=

# Aliases also accepted by the app (optional):
# HUGGINGFACE_HUB_TOKEN=
# HF_TOKEN=

# Optional: pyannote precision-2 product key (only if you use that model)
# PYANNOTE_PRECISION2_API_KEY=

# --- LLM analysis (optional) ------------------------------------------------
# Cloud (optional — leave blank to work offline with LM Studio):
OPENAI_API_KEY=
GEMINI_TRANSCRIBE_ANALYSIS_API_KEY=

# Local offline analysis via LM Studio (OpenAI-compatible server):
# 1) Start LM Studio → Local Server → Start Server
# 2) Load a chat model
# 3) Click ↻ next to Backend in VocalTrace to list models
# Defaults work out of the box for most installs:
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_API_KEY=lm-studio

# Optional
# GROK_API_KEY=

# --- Tools ------------------------------------------------------------------
# VOCALTRACE_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# VOCALTRACE_LOGLEVEL=INFO
